<file path="src/services/firestore.rules">
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function membershipDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }
    function isMember(businessId) {
      return request.auth != null && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }
    function myRole(businessId) {
      return membershipDoc(businessId).data.role;
    }
    function isElevated(businessId) {
      return isMember(businessId) && myRole(businessId) in ['owner', 'manager'];
    }
    function hasModule(businessId, moduleName) {
      return isElevated(businessId)
        || (isMember(businessId) && moduleName in membershipDoc(businessId).data.modules);
    }
    // BP-055: crear un producto/receta nueva es una decisión de negocio,
    // separada del día a día operativo de Inventario/Producción.
    function canCreateProducts(businessId) {
      return isElevated(businessId)
        || (isMember(businessId) && membershipDoc(businessId).data.canCreateProducts == true);
    }

    match /businesses/{businessId} {
      allow read: if isMember(businessId);
      allow write: if isElevated(businessId);

      match /members/{memberUid} {
        allow read: if request.auth.uid == memberUid || isMember(businessId);
        allow write: if isElevated(businessId)
          || (request.auth.uid == memberUid
              && !exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)));
      }

      match /sales/{docId}     { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'ventas'); }
      match /invoices/{docId}  { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'ventas'); }
      match /payments/{docId}  { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'ventas'); }
      match /customers/{docId} { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'clientes'); }

      match /purchaseOrders/{docId}   { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'compras'); }
      match /suppliers/{docId}        { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'compras'); }
      match /supplierPayments/{docId} { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'compras'); }

      match /rawMaterials/{docId}  { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'inventario') || hasModule(businessId, 'produccion'); }
      match /finishedGoods/{docId} { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'inventario') || hasModule(businessId, 'produccion'); }
      match /wasteLog/{docId}      { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'inventario') || hasModule(businessId, 'produccion'); }

      // BP-055: recetas/BOM — crear es la decisión de negocio gated;
      // actualizar (ej. sumar/restar stock al producir) sigue disponible
      // para quien ya tiene el módulo operativo; borrar solo elevado.
      match /recipes/{docId} {
        allow read: if isMember(businessId);
        allow create: if canCreateProducts(businessId);
        allow update: if hasModule(businessId, 'inventario') || hasModule(businessId, 'produccion');
        allow delete: if isElevated(businessId);
      }

      match /inventoryAdjustments/{docId} { allow read: if isMember(businessId); allow write: if isElevated(businessId); }

      match /marketingPosts/{docId}    { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'marketing'); }
      match /marketingStrategy/{docId} { allow read: if isMember(businessId); allow write: if hasModule(businessId, 'marketing'); }

      // Cualquier colección futura, o `products` (retirada, ver BP-055):
      // solo owner/manager hasta que se le agregue su línea propia.
      match /{document=**} {
        allow read: if isMember(businessId);
        allow write: if isElevated(businessId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
</file>

