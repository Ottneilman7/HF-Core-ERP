  lowRawMaterials: RawMaterial[];
  lowTrackedRecipes: Recipe[];
}

const rowStyle: React.CSSProperties = {
  display: "flex",
  alignItems: "center",
  gap: "10px",
  padding: "8px 12px",
  borderLeft: "4px solid #c62828",
  borderRadius: "6px",
  background: "rgba(255,255,255,0.03)",
  marginBottom: "8px",
