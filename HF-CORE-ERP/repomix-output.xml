              : "inset 0 1px 2px rgba(0,0,0,0.3)",
            transition: "all 0.15s ease",
            cursor: "pointer",
            boxSizing: "border-box",
            ...style,
          }}
        >
          {children}
        </select>
        <span
          style={{
            position: "absolute",
            right: "12px",
