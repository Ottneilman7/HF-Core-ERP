# Copiar este archivo a .env.local (NO subir .env.local a git) y llenar
# con los valores reales del proyecto de Firebase (Firebase Console >
# Configuración del proyecto > tus apps > SDK setup).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PIN de supervisor para ajustes manuales de inventario (InventoryPage,
# inventoryAdjustmentService). Elegir un valor nuevo — el PIN anterior
# quedó expuesto en el historial público de GitHub y debe considerarse
# comprometido, no reutilizar.
VITE_SUPERVISOR_PIN=
